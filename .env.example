DATABASE_URL=replace-with-postgres-connection-url
APP_PORT=3000
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=replace-with-db-name
POSTGRES_PORT=5432

AUTH_SECRET=replace-with-auth-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-5.2
OPENROUTER_INTERVIEW_MODEL=openai/gpt-4o-mini
OPENROUTER_FINAL_MODEL=openai/gpt-5.2
OPENROUTER_INTERVIEW_MAX_TOKENS=220
OPENROUTER_FINAL_MAX_TOKENS=2800
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=marin
OPENROUTER_TTS_SPEED=1.12

NEXT_PUBLIC_SITE_URL=https://offerlyra.ru
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Set to true, 1, yes, or on to let signed-in users analyze resumes without spending credits.
FREE_RESUME_ANALYSIS_ENABLED=false
